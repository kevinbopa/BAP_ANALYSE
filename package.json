{
  "name": "bp-edge-sports-prediction-engine",
  "version": "1.0.0",
  "private": true,
  "description": "BP//EDGE Sports Prediction Engine - dashboard, data ingestion, predictions and verified betting performance.",
  "scripts": {
    "dev": "node scripts/run_python.js scripts/dev_dashboard.py",
    "start": "npm run dashboard",
    "dashboard": "node scripts/run_python.js apps/dashboard/app.py",
    "dashboard:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop_dashboard.ps1",
    "db:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_local_postgres.ps1",
    "db:backup": "node scripts/run_python.js scripts/db_backup.py",
    "db:restore": "node scripts/run_python.js scripts/db_restore.py",
    "db:migrate": "node scripts/run_python.js scripts/apply_migrations.py",
    "db:migrate:plan": "node scripts/run_python.js scripts/apply_migrations.py --plan",
    "db:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/teardown_local_postgres.ps1",
    "bootstrap:admin": "node scripts/run_python.js scripts/bootstrap_admin.py",
    "cycle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daily_cycle.ps1",
    "cycle:plan": "node scripts/run_python.js scripts/run_cycle.py --plan",
    "cycle:run": "node scripts/run_python.js scripts/run_cycle.py --profile daily --trigger MANUAL",
    "validate:back": "node scripts/run_python.js services/prediction/run_validate_back.py --sport all",
    "validate:back:football": "node scripts/run_python.js services/prediction/run_validate_back.py --sport football",
    "validate:back:golf": "node scripts/run_python.js services/prediction/run_validate_back.py --sport golf",
    "check": "npm run check:migrations && npm run check:python && npm test",
    "check:migrations": "node scripts/run_python.js scripts/apply_migrations.py --validate-only && node scripts/run_python.js scripts/check_migration_safety.py",
    "check:release": "node scripts/run_python.js scripts/release_preflight.py",
    "check:python": "node scripts/run_python.js -m compileall -q apps scripts services tests",
    "test": "npm run test:smoke && npm run test:prediction && npm run test:ingestion",
    "test:smoke": "node scripts/run_python.js tests/smoke/check_dashboard_app.py && node scripts/run_python.js tests/smoke/check_db_migrations.py",
    "test:prediction": "node scripts/run_python.js -m unittest discover -s services/prediction/tests -p \"test_*.py\"",
    "test:ingestion": "node scripts/run_python.js -m unittest discover -s services/ingestion/tests -p \"test_*.py\""
  },
  "engines": {
    "node": ">=20"
  }
}
