APP_ENV=local
SESSION_SECRET=replace_with_long_random_secret
SESSION_TTL_HOURS=24
PASSWORD_MIN_LENGTH=10
BOOTSTRAP_ADMIN_EMAIL=admin@bp-edge.local
BOOTSTRAP_ADMIN_NAME=BP Edge Admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_password

# =============================================================================
# PostgreSQL local (Docker)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sports_prediction_engine
POSTGRES_USER=spe_app_rw
POSTGRES_PASSWORD=spe_app_password
POSTGRES_INGEST_HOST=localhost
POSTGRES_INGEST_PORT=5432
POSTGRES_INGEST_DB=sports_prediction_engine
POSTGRES_INGEST_USER=spe_ingest_rw
POSTGRES_INGEST_PASSWORD=spe_ingest_password

# =============================================================================
# TheSportsDB — historique equipes / fixtures / scores
# Cle gratuite '123' = donnees tronquees (10 ligues, 5 saisons, 15 events/saison).
# Remplacer par une cle Premium (Patreon) pour l'historique complet.
# =============================================================================
THESPORTSDB_API_KEY=123
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_TIMEOUT_SECONDS=20
# Avec une cle Premium (100 req/min), baisser a 1.0 pour une sync ~2x plus rapide.
THESPORTSDB_MIN_INTERVAL_SECONDS=2.2
THESPORTSDB_MAX_RETRIES=4
THESPORTSDB_HISTORY_START_YEAR=2015
# IDs de ligues internationales forces (contournement de la liste tronquee en cle gratuite).
# WC=4429, Nations League=4490, Copa America=4499, Euro=4502, Confederations Cup=4498.
# + Championnats europeens (D1) : Eredivisie=4337, Primeira Liga=4344, Belgian Pro League=4338,
# Scottish Premiership=4330, Super Lig=4339, Autriche=4621, Suisse=4675, Danemark=4340,
# Norvege=4358, Suede=4347, Grece=4336, Pologne=4422, Tchequie=4631, Croatie=4629,
# Ukraine=4354, Russie=4355, Serbie=4671, Roumanie=4691, Hongrie=4690, Finlande=4636,
# Irlande=4643, EFL Championship=4329 + UEFA : CL=4480, EL=4481, Conference=5071.
THESPORTSDB_EXTRA_LEAGUE_IDS=4429,4490,4499,4502,4498,4337,4344,4338,4330,4339,4621,4675,4340,4358,4347,4336,4422,4631,4629,4354,4355,4671,4691,4690,4636,4643,4329,4480,4481,5071

# =============================================================================
# The Odds API — cotes 1X2 multi-bookmakers
# =============================================================================
THEODDS_API_KEY=replace_with_theoddsapi_key
THEODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# auto = ne demander des cotes que pour les ligues ayant des matchs a venir en base
# (protege le quota : les ligues en intersaison ne coutent rien).
THEODDS_API_SPORT_KEYS=auto
# bet365 vit dans les regions uk/au (pas eu). uk = books UK ; eu = consensus (pinnacle, betsson, unibet...)
THEODDS_API_REGIONS=uk,eu
THEODDS_API_MARKETS=h2h,totals
# BTTS : endpoint par evenement (cout quota par match) - fenetre avant kickoff, 0 = off
THEODDS_API_BTTS_LOOKAHEAD_HOURS=72
# Plafond d appels BTTS par sync (2 credits chacun en uk,eu) - protege le quota en pleine saison
THEODDS_API_BTTS_MAX_EVENTS=20
THEODDS_API_ODDS_FORMAT=decimal
THEODDS_API_DATE_FORMAT=iso
# Vide = ingerer TOUS les bookmakers (necessaire au consensus du modele).
THEODDS_API_BOOKMAKERS=
THEODDS_API_LOOKBACK_HOURS=6
THEODDS_API_LOOKAHEAD_DAYS=14
THEODDS_API_MATCH_WINDOW_MINUTES=180
THEODDS_API_TIMEOUT_SECONDS=20

# =============================================================================
# Ciblage bookmaker — la ou tu paries reellement (deals affiches).
# Doit etre couvert par The Odds API (bet365 ne l'est pas). Ex: pinnacle, betsson, unibet.
# =============================================================================
SPE_TARGET_BOOKMAKER=pinnacle

# =============================================================================
# API-Football (api-sports.io) — couche joueurs : effectifs, blessures, notes de match.
# Compte gratuit (100 req/jour) : https://www.api-football.com/
# =============================================================================
APIFOOTBALL_KEY=
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io
APIFOOTBALL_TIMEOUT_SECONDS=20
APIFOOTBALL_MIN_INTERVAL_SECONDS=6.5
APIFOOTBALL_SEASON_YEAR=2026
APIFOOTBALL_REQUEST_BUDGET=90

# =============================================================================
# Stake — connecteur cotes secondaire (non prioritaire en V1)
# =============================================================================
STAKE_API_TOKEN=
STAKE_API_BASE_URL=https://odds-data.stake.com
STAKE_AUTH_HEADER=X-API-KEY
STAKE_AUTH_SCHEME=
STAKE_SPORTS_PATH=/sports
STAKE_CATEGORIES_PATH_TEMPLATE=/sports/{sport}/categories
STAKE_TOURNAMENTS_PATH_TEMPLATE=/sports/{sport}/{category}/tournaments
STAKE_FIXTURES_PATH_TEMPLATE=/sports/{sport}/{category}/{tournament}/fixtures
STAKE_FIXTURE_PATH_TEMPLATE=/fixtures/{fixture_slug}
STAKE_ODDS_PATH_TEMPLATE=/odds/{fixture_slug}
STAKE_SPORT_SLUG=soccer
STAKE_LOOKAHEAD_DAYS=90
STAKE_MATCH_WINDOW_MINUTES=720
STAKE_TIMEOUT_SECONDS=20

# =============================================================================
# DataGolf — feed golf circuit complet (strokes-gained, predictions, matchups)
# Cle sur https://datagolf.com/api-access (abo Scratch Plus).
# =============================================================================
DATAGOLF_API_KEY=
DATAGOLF_BASE_URL=https://feeds.datagolf.com
DATAGOLF_FILE_FORMAT=json
DATAGOLF_ODDS_FORMAT=decimal
DATAGOLF_TOURS=pga,euro,kft,liv
DATAGOLF_CATALOG_TOURS=all
DATAGOLF_TIMEOUT_SECONDS=20
DATAGOLF_MIN_INTERVAL_SECONDS=1.5
DATAGOLF_MAX_RETRIES=3

# Cle secrete pour la creation de comptes ADMIN via /signup (generer une valeur forte).
ADMIN_SIGNUP_KEY=change-me-strong-secret
