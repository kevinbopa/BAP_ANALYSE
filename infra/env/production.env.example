BOOTSTRAP_ADMIN_PASSWORD=replace_with_production_admin_password
ADMIN_SIGNUP_KEY=replace_with_production_signup_key

POSTGRES_HOST=production-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=sports_prediction_engine
POSTGRES_USER=spe_app_rw
POSTGRES_PASSWORD=replace_with_production_app_password
POSTGRES_INGEST_HOST=production-postgres-host
POSTGRES_INGEST_PORT=5432
POSTGRES_INGEST_DB=sports_prediction_engine
POSTGRES_INGEST_USER=spe_ingest_rw
