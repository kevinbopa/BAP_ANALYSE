APP_ENV=staging
SPE_AUTH_DISABLED=0
SESSION_SECRET=replace_with_staging_session_secret
SESSION_TTL_HOURS=24
PASSWORD_MIN_LENGTH=10
BOOTSTRAP_ADMIN_EMAIL=admin-staging@bp-edge.local
BOOTSTRAP_ADMIN_NAME=BP Edge Staging Admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_staging_admin_password
ADMIN_SIGNUP_KEY=replace_with_staging_signup_key

POSTGRES_HOST=staging-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=sports_prediction_engine_staging
POSTGRES_USER=spe_app_rw
POSTGRES_PASSWORD=replace_with_staging_app_password
POSTGRES_INGEST_HOST=staging-postgres-host
POSTGRES_INGEST_PORT=5432
POSTGRES_INGEST_DB=sports_prediction_engine_staging
POSTGRES_INGEST_USER=spe_ingest_rw
POSTGRES_INGEST_PASSWORD=replace_with_staging_ingest_password

THESPORTSDB_API_KEY=replace_with_staging_thesportsdb_key
THEODDS_API_KEY=replace_with_staging_theoddsapi_key
APIFOOTBALL_KEY=replace_with_staging_apifootball_key
DATAGOLF_API_KEY=replace_with_staging_datagolf_key

THESPORTSDB_HISTORY_START_YEAR=2022
THEODDS_API_SPORT_KEYS=auto
THEODDS_API_REGIONS=uk,eu
THEODDS_API_MARKETS=h2h,totals
THEODDS_API_LOOKAHEAD_DAYS=7
THEODDS_API_MATCH_WINDOW_MINUTES=180
APIFOOTBALL_REQUEST_BUDGET=30
DATAGOLF_TOURS=pga,euro
SPE_TARGET_BOOKMAKER=pinnacle
