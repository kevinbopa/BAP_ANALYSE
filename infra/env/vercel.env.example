APP_ENV=production
SPE_AUTH_DISABLED=0
SESSION_SECRET=replace_with_long_random_session_secret
SESSION_TTL_HOURS=24
PASSWORD_MIN_LENGTH=10

BOOTSTRAP_ADMIN_EMAIL=admin@bp-edge.local
BOOTSTRAP_ADMIN_NAME=BP Edge Admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_SIGNUP_KEY=replace_with_strong_signup_key

# Main app database used by the dashboard on Vercel
DATABASE_URL=postgresql://replace_with_neon_user:replace_with_neon_password@replace_with_neon_host/sports_prediction_engine?sslmode=require
POSTGRES_HOST=replace_with_neon_host
POSTGRES_PORT=5432
POSTGRES_DB=sports_prediction_engine
POSTGRES_USER=replace_with_neon_user
POSTGRES_PASSWORD=replace_with_neon_password

# Optional: separate migration/admin credentials if your provider gives them
POSTGRES_MIGRATE_HOST=replace_with_neon_host
POSTGRES_MIGRATE_PORT=5432
POSTGRES_MIGRATE_DB=sports_prediction_engine
POSTGRES_MIGRATE_USER=replace_with_neon_admin_user
POSTGRES_MIGRATE_PASSWORD=replace_with_neon_admin_password
